---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${site.name} | Impresión 3D en Neza y CDMX`,
  description = site.description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.jpg", Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: `${site.name} (${site.longName})`,
  description: site.description,
  url: site.url,
  image: ogImage,
  sameAs: [site.instagram],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Nezahualcóyotl",
    addressRegion: "Estado de México",
    addressCountry: "MX",
  },
  areaServed: ["Ciudad de México", "Zona metropolitana del Valle de México"],
  paymentAccepted: "Tarjeta de crédito, tarjeta de débito, transferencia, efectivo",
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f2fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d0a12" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/bricolage-grotesque-es.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PROIN, diseño e impresión 3D: lámpara, trofeo y llaveros impresos" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
