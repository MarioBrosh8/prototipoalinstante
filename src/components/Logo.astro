---
// Pro-In's logos, from the vectors in src/data/logo.ts (traced from the files
// they sent). variant="full" is "Pro" + the mark + "-In"; "mark" is the hotend
// and eye alone.
//
// With `animate`, the hotend drops in and the filament draws the whole eye as
// one continuous line, the way the printer would extrude it; the letters print
// in layers. The eye is revealed through a mask of centerline pieces, each with
// its own width (wide at the corners, narrow in the spiral) and its share of
// the time. A full-size rect seals the mask at the end so nothing stays
// uncovered. Below the fold, initReveals() adds .pre and the animation waits
// for .is-in.
import { drawPieces, eye, fullBox, hotend, letters, markBox, place } from "../data/logo";

interface Props {
  variant?: "mark" | "full";
  animate?: boolean;
  /** Accessible name; leave empty when the logo sits next to visible text. */
  title?: string;
  class?: string;
}

const { variant = "mark", animate = false, title, class: className } = Astro.props;
const full = variant === "full";
const box = full ? fullBox : markBox;
const id = `lg${Math.random().toString(36).slice(2, 8)}`;

// Timeline in ms.
const penAt = full ? 320 : 260;
const pen = full ? 1700 : 1500;
const pieces = drawPieces.map((p) => ({
  ...p,
  at: Math.round(penAt + p.from * pen),
  dur: Math.round((p.to - p.from) * pen),
}));
const sealAt = penAt + pen;
const maskBox = { x: 90, y: 140, w: 300, h: 350 };
---

<svg
  class:list={["logo", full ? "logo--full" : "logo--mark", { "logo--anim": animate }, className]}
  viewBox={`${box.x} ${box.y} ${box.w} ${box.h}`}
  role={title ? "img" : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : "true"}
  focusable="false"
  data-draw={animate ? "" : undefined}
>
  {
    full && (
      <g class="logo__words">
        <path class="logo__word" style="--at:180ms" fill="var(--logo-ink)" d={letters.pro} />
        <path class="logo__word" style="--at:640ms" fill="var(--logo-green)" d={letters.in} />
      </g>
    )
  }
  <g transform={full ? `matrix(${place.s} 0 0 ${place.s} ${place.x} ${place.y})` : undefined}>
    {
      animate && (
        <mask id={id} maskUnits="userSpaceOnUse" x={maskBox.x} y={maskBox.y} width={maskBox.w} height={maskBox.h}>
          <g fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round">
            {pieces.map((p) => (
              <path class="logo__piece" d={p.d} stroke-width={p.w} pathLength="1" style={`--at:${p.at}ms;--dur:${p.dur}ms`} />
            ))}
          </g>
          <rect
            class="logo__seal"
            x={maskBox.x}
            y={maskBox.y}
            width={maskBox.w}
            height={maskBox.h}
            fill="#fff"
            style={`--at:${sealAt}ms`}
          />
        </mask>
      )
    }
    <path class="logo__eye" fill="var(--logo-ink)" d={eye} mask={animate ? `url(#${id})` : undefined} />
    <g class="logo__head">
      <path fill="var(--logo-ink)" d={hotend.block} />
      <path fill="var(--logo-ink)" d={hotend.nozzle} />
      <path fill="var(--logo-light)" d={hotend.panel} />
      <path fill="var(--logo-light)" d={hotend.window} />
    </g>
  </g>
</svg>

<style>
  .logo {
    display: block;
    width: auto;
    height: 100%;
    overflow: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo--anim .logo__head {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: logo-head 460ms var(--ease-out) both;
    }

    /* Dash 1, gap 2: at offset 1.01 nothing touches the start, so round caps
       can't leave a dot there before the pen arrives. */
    .logo--anim .logo__piece {
      stroke-dasharray: 1 2;
      animation: logo-draw var(--dur) linear var(--at) both;
    }

    .logo--anim .logo__seal {
      animation: logo-hold var(--at) linear backwards;
    }

    .logo--anim .logo__word {
      animation: logo-print 660ms steps(10, end) var(--at) both;
    }

    /* Below the fold: hold the empty first frame until it scrolls in. */
    .logo--anim:global(.pre):not(:global(.is-in)) .logo__head {
      animation: none;
      opacity: 0;
    }

    .logo--anim:global(.pre):not(:global(.is-in)) .logo__piece {
      animation: none;
      stroke-dashoffset: 1.01;
    }

    .logo--anim:global(.pre):not(:global(.is-in)) .logo__seal {
      animation: none;
      opacity: 0;
    }

    .logo--anim:global(.pre):not(:global(.is-in)) .logo__word {
      animation: none;
      clip-path: inset(100% 0 0 0);
    }
  }

  @keyframes logo-head {
    from {
      opacity: 0;
      transform: translateY(-34%);
    }
  }

  @keyframes logo-draw {
    from {
      stroke-dashoffset: 1.01;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes logo-hold {
    from,
    to {
      opacity: 0;
    }
  }

  @keyframes logo-print {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
