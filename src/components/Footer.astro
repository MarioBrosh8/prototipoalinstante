---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { cta, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__top">
    <div class="footer__brand">
      <span class="footer__mark"><Logo /></span>
      <span>
        <span class="footer__name">{site.name}</span>
        <span class="footer__long">{site.longName}</span>
      </span>
    </div>
    <p class="footer__about">
      Diseño e impresión 3D. {site.location}, con envíos a {site.areaServed}.
    </p>
    <nav class="footer__links" aria-label="Contacto">
      <a href={site.dm} target="_blank" rel="noopener">
        {cta.contact}
        <Icon name="arrow-up-right" size={16} />
      </a>
      <a href={site.instagram} target="_blank" rel="noopener">
        Instagram
        <Icon name="arrow-up-right" size={16} />
      </a>
    </nav>
  </div>
  <div class="wrap footer__base">
    <p>© {year} {site.name}, {site.longName}.</p>
    <p>Sitio por <a href="https://mariovaldez.dev" target="_blank" rel="noopener">Mario Valdez</a></p>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(56px, 8vw, 96px) max(28px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
  }

  .footer__top {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 4vw, 56px);
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer__mark {
    display: block;
    height: 52px;
  }

  .footer__name {
    display: block;
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .footer__long {
    display: block;
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .footer__about {
    color: var(--ink-2);
    max-width: 44ch;
  }

  .footer__links {
    display: flex;
    gap: 8px;
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition:
      background-color 200ms ease,
      transform 160ms var(--ease-out);
  }

  .footer__links a:active {
    transform: scale(0.97);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(36px, 5vw, 56px);
    font-size: 0.88rem;
    color: var(--ink-3);
  }

  .footer__base a {
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__links a:hover {
      background: var(--brand-wash);
    }

    .footer__base a:hover {
      color: var(--ink);
    }
  }

  @media (max-width: 859px) {
    .footer__top {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
</style>
