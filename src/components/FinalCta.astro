---
import Icon from "./Icon.astro";
import { cta, site } from "../data/site";

const title = "¿Lo imprimimos?";
---

<section class="final" id="lo-imprimimos" aria-labelledby="final-title">
  <div class="final__band" data-final>
    <div class="final__inner">
      <h2 id="final-title" class="final__title">
        <span class="final__layer final__outline" aria-hidden="true">{title}</span>
        <span class="final__layer final__infill" aria-hidden="true">{title}</span>
        <span class="final__layer final__solid">{title}</span>
      </h2>
      <p class="final__text">Mándanos tu idea por DM y te cotizamos. Si quieres, abajo te ayudamos a armar el mensaje.</p>
      <div class="final__ctas">
        <a class="btn btn--light" href={site.dm} target="_blank" rel="noopener" data-magnetic>
          {cta.contact}
          <span class="btn__icon"><Icon name="paper-plane-tilt" size={18} /></span>
        </a>
        <a class="final__ig" href={site.instagram} target="_blank" rel="noopener">
          <Icon name="instagram-logo" size={20} />
          {site.handle}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final {
    padding-inline: var(--gutter);
    padding-block: clamp(24px, 4vw, 48px);
  }

  .final__band {
    --hatch: 1;
    --solid: 1;
    max-width: calc(var(--maxw) + 160px);
    margin-inline: auto;
    border-radius: var(--radius-panel);
    color: #fdfbff;
    background:
      var(--pattern) 0 0 / 88px 88px,
      radial-gradient(90% 120% at 85% 10%, rgb(255 255 255 / 0.1), transparent 55%),
      linear-gradient(155deg, var(--brand-deep) 0%, var(--brand) 62%, #a558ce 100%);
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / 0.18),
      0 40px 80px -48px rgb(80 5 137 / 0.7);
    overflow: hidden;
  }

  .final__inner {
    display: grid;
    justify-items: center;
    gap: 24px;
    padding: clamp(72px, 11vw, 150px) var(--gutter);
    text-align: center;
  }

  .final__title {
    display: grid;
    font-size: clamp(3.1rem, 11.5vw, 9.6rem);
    font-weight: 800;
    /* Tight, but short of glyphs overlapping (overlaps show hairline seams). */
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  /* Three copies of the same line, stacked: perimeter, infill, top layers. */
  .final__layer {
    grid-area: 1 / 1;
    padding: 0 0.04em 0.16em;
  }

  .final__outline {
    color: transparent;
    -webkit-text-stroke: 2px rgb(253 251 255 / 0.9);
  }

  .final__infill {
    color: transparent;
    background:
      repeating-linear-gradient(45deg, rgb(253 251 255 / 0.75) 0 2px, transparent 2px 11px),
      repeating-linear-gradient(-45deg, rgb(253 251 255 / 0.75) 0 2px, transparent 2px 11px);
    -webkit-background-clip: text;
    background-clip: text;
    opacity: var(--hatch);
  }

  .final__solid {
    color: #fdfbff;
    clip-path: inset(calc((1 - var(--solid)) * 100%) 0 0 0);
  }

  .final__text {
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    color: rgb(253 251 255 / 0.86);
    text-wrap: balance;
  }

  .final__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 22px;
    margin-top: 8px;
  }

  .final__ig {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 6px;
    font-weight: 600;
    color: rgb(253 251 255 / 0.9);
    border-radius: var(--radius-pill);
  }

  .final__ig:focus-visible {
    outline-color: #fdfbff;
  }

  @media (hover: hover) and (pointer: fine) {
    .final__ig:hover {
      color: #fff;
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  .final__band :global(.btn:focus-visible) {
    outline-color: #fdfbff;
  }
</style>
