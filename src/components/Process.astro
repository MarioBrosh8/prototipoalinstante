---
import Icon from "./Icon.astro";
import { pasos } from "../data/site";
---

<section class="section process" id="proceso" aria-labelledby="process-title">
  <div class="wrap">
    <header class="process__head">
      <h2 id="process-title" class="h2" data-reveal>Así se imprime tu idea.</h2>
      <p class="lede" data-reveal style="--i:1">Cuatro pasos, del primer mensaje a la entrega.</p>
    </header>

    <div class="process__body" data-process>
      <svg class="process__svg" aria-hidden="true" focusable="false">
        <path class="process__ghost" data-ghost></path>
        <path class="process__line" data-line></path>
      </svg>
      <span class="process__nozzle" aria-hidden="true" data-nozzle>
        <svg viewBox="0 0 330 290" width="34" height="30">
          <rect x="4" y="4" width="322" height="160" rx="26" fill="#8a3bc1"></rect>
          <rect x="38" y="28" width="254" height="72" rx="8" fill="#b98ae8"></rect>
          <path d="M69 164 H260 V224 Q260 274 210 274 H119 Q69 274 69 224 Z" fill="#8a3bc1"></path>
        </svg>
        <span class="process__hot"></span>
      </span>

      <ol class="process__steps">
        {
          pasos.map((p, i) => (
            <li class="step" data-step data-reveal style={`--i:${i}`}>
              <span class="step__node" data-node>
                <Icon name={p.icono} size={22} />
              </span>
              <h3 class="step__verb">{p.verbo}</h3>
              <p class="step__text">{p.texto}</p>
              <p class="step__dato">{p.dato}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .process__head {
    display: grid;
    gap: 18px;
    max-width: 720px;
    margin-bottom: clamp(48px, 7vw, 88px);
  }

  .process__body {
    position: relative;
  }

  .process__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .process__ghost {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 2;
    stroke-dasharray: 1 9;
    stroke-linecap: round;
  }

  .process__line {
    fill: none;
    stroke: var(--brand);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .process__nozzle {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    display: none;
    will-change: transform;
  }

  .process__hot {
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff1e0 0%, #ffb070 45%, transparent 72%);
    box-shadow: 0 0 16px 4px rgb(255 140 60 / 0.55);
  }

  .process__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 44px);
  }

  .step {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .step__node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 18px;
    border-radius: 50%;
    background: var(--brand);
    color: var(--on-brand);
    box-shadow:
      0 0 0 6px var(--bg),
      0 12px 26px -12px var(--shadow-color);
    transition:
      background-color 300ms ease,
      color 300ms ease,
      transform 420ms var(--ease-out);
  }

  .step__verb {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    font-weight: 720;
    letter-spacing: -0.03em;
    line-height: 1.05;
    transition: color 300ms ease;
  }

  .step__text {
    color: var(--ink-2);
    max-width: 34ch;
    transition: color 300ms ease;
  }

  .step__dato {
    justify-self: start;
    margin-top: 4px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--brand-wash);
    color: var(--accent-text);
    font-size: 0.85rem;
    font-weight: 650;
  }

  /* With JS, steps wait unlit until the printed line reaches them. */
  .is-live .step:not(.is-lit) .step__node {
    background: var(--bg-raised);
    color: var(--ink-3);
    box-shadow:
      0 0 0 6px var(--bg),
      inset 0 0 0 1px var(--line-strong);
  }

  .is-live .step:not(.is-lit) .step__verb {
    color: var(--ink-3);
  }

  .is-live .step.is-lit .step__node {
    transform: scale(1.06);
  }

  .is-live .process__nozzle {
    display: block;
  }

  @media (max-width: 899px) {
    .process__steps {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .step {
      padding-left: 78px;
      position: relative;
    }

    .step__node {
      position: absolute;
      left: 0;
      top: -4px;
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process__nozzle {
      display: none !important;
    }
  }
</style>
