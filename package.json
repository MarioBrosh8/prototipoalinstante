{
  "name": "prototipoalinstante",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio de PROIN (Prototipo al Instante): diseño e impresión 3D en Neza y CDMX.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev --port 8791",
    "check": "astro check",
    "images": "node scripts/images.mjs",
    "deploy": "npm run check && npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.3.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/three": "^0.186.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.136.3"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "workerd": true
  }
}
