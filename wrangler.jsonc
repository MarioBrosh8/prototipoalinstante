{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prototipoalinstante",
  "compatibility_date": "2026-09-22",

  // Pure static-asset Worker: no script. Cloudflare serves dist/ from the edge.
  // public/_headers sets caching and security headers for these assets.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Pro-In's own domain (zone prototipoalinstante.com, same account).
  // custom_domain creates the DNS record and certificate on first deploy.
  // The first address, prototipoalinstante.mariovaldez.dev, keeps serving the
  // same site; its canonical URL points at the .com. www is a separate
  // redirect Worker (workers/www-redirect) so this one stays script-free.
  "routes": [
    { "pattern": "prototipoalinstante.com", "custom_domain": true },
    { "pattern": "prototipoalinstante.mariovaldez.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
